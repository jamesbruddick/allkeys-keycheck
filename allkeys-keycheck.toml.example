# allkeys-keycheck configuration
#
# Runs as it stands: put your keys in input.txt, then run with no arguments.
# Every setting has a matching command-line flag, which overrides it.


# The file of secrets to scan, one per line. It is a queue: scanned lines leave
# it as each batch finishes, so keep a copy of anything you want to scan twice.
input = "input.txt"

# The ledger of everything ever found. Written on every run, and read before
# every scan: a key or phrase already in here leaves the input straight away
# rather than being looked up a second time.
found = "found.txt"

# Where the findings are saved. Merged into, never replaced. A run needs this,
# upload, or both.
output = "output.txt"

# Also submit found keys to allkeys.directory. This sends private keys off the
# machine and cannot be undone. Needs allkeys-api-key below.
upload = false

# Which indices of each mnemonic chain to scan: a count for that many at each
# end, or absolute windows like "10..110". Always quoted.
# indices = "10"

# How far each round follows a phrase that turned something up, in indices,
# or false to scan the indices count exactly and follow nothing further.
# expand = 400

# Maximum addresses per API request. 1500 is also the most the API will take —
# a larger batch comes back empty rather than as an error.
# api-batch = 1500

# How many API requests to keep in flight at once. This is what makes a large
# scan finish; lower it to be gentler on blockchain.info. Maximum 16.
# concurrency = 8

# How many phrases to carry through the run at a time.
# phrase-batch = 100

# Milliseconds each connection waits after a successful API request.
# delay = 0

# Derive and print addresses without contacting the network.
# dry-run = true


# Secrets. Kept here rather than on the command line, where they are visible to
# other processes. Restrict the file if you fill any in:  chmod 600
#
# Left commented out: a blank key is sent and rejected, where a missing one
# fails before the scan starts.
[secrets]

# BIP39's optional 25th word.
# passphrase = "..."

# Raises the blockchain.info rate limit.
# blockchain-api-key = "..."

# Required by upload.
# allkeys-api-key = "ak_..."
