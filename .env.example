# Copy to .env and fill in the values below. .env is gitignored; restrict it
# with chmod 600 so no other user on the machine can read your keys.

# allkeys.directory API key, used by --upload
ALLKEYS_API_KEY=ak_...

# Optional: blockchain.info API key, raises the lookup rate limit
# BLOCKCHAIN_API_KEY=

# Optional: BIP39 passphrase (the 25th word) applied to every mnemonic in the
# input. Set it here rather than on the command line, where it would be visible
# in your shell history and in the process list.
# BIP39_PASSPHRASE=
